{
  "expo": {
    "name": "CycleSense",
    "slug": "cyclesense",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cyclesense",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.mobileappbuilder.y0lu2t"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
      "backgroundColor": "#121417"
      },
      "package": "com.androspace.cyclesense"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#121417"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "expo-sharing",
      "expo-notifications",
      "./plugins/withDynamicIcon",
      "./modules/cyclesense-native/app.plugin.js"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
